# VidroGestor — variáveis de ambiente (staging)
# Copie para .env.local (Next.js) e configure no Vercel (Project Settings → Environment Variables).
# NUNCA commitar valores reais.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
# Apenas no servidor (nunca expor no client). Usada em rotas admin/seed.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Storage (bucket de documentos/fotos) — criar no Supabase Storage
NEXT_PUBLIC_SUPABASE_BUCKET=documentos

# Ambiente
NEXT_PUBLIC_APP_ENV=staging
